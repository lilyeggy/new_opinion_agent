# Copy to .env and fill in the blanks. .env is git-ignored.
#
#   cp .env.example .env
#   set -a; . ./.env; set +a
#
# The model endpoint is <base>/chat/completions, so the base must already
# include the version segment (usually /v1).

# ---- model (required) ----
# Official DeepSeek platform (what the live runs in artifacts/ used):
OPINION_MODEL_BASEURL=https://api.deepseek.com/v1
OPINION_MODEL_NAME=deepseek-flash
OPINION_MODEL_API_KEY=

# Alternative: OpenCode zen gateway.
# OPINION_MODEL_BASEURL=https://opencode.ai/zen/go/v1
# OPINION_MODEL_NAME=deepseek-flash
# OPINION_MODEL_EXTRA_HEADERS={"x-opencode-session": "<session>"}

# OPINION_MODEL_BASE_URL (with underscore before URL) takes precedence over
# OPINION_MODEL_BASEURL when both are set.

# ---- search (required) ----
BRAVE_SEARCH_API_KEY=

# ---- reader (optional; without it pages are fetched directly) ----
# JINA_API_KEY=

# ---- tuning (optional) ----
OPINION_MODEL_TIMEOUT_SECONDS=120
OPINION_MODEL_TRANSPORT_ATTEMPTS=3
OPINION_MODEL_MAX_OUTPUT_TOKENS=4096
OPINION_MAX_DECISION_ATTEMPTS=3
OPINION_ALLOW_INSECURE_MODEL_ENDPOINT=false
OPINION_INVESTIGATION_SECONDS=2400
OPINION_INVESTIGATION_MODEL_CALLS=120

# ---- shell note ----
# If NO_PROXY contains a bracketed IPv6 entry such as [::1], httpx rejects the
# value ("Invalid port: ':1]'"). Use instead:
#   export NO_PROXY="localhost,127.0.0.1,::1"
